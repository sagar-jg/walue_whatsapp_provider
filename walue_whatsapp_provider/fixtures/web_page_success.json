    "show_title": 0,
    "full_width": 1,
    "main_section": "<style>\n:root {\n    --primary: #25D366;\n    --primary-dark: #128C7E;\n    --secondary: #075E54;\n    --dark: #1a1a2e;\n    --light-bg: #f8fafc;\n}\nbody { font-family: 'Inter', -apple-system, sans-serif; background-color: var(--light-bg); min-height: 100vh; }\n.walue-navbar { padding: 1rem 0; background: linear-gradient(135deg, var(--secondary) 0%, var(--primary-dark) 100%) !important; }\n.walue-navbar .navbar-brand { font-weight: 700; font-size: 1.4rem; color: white; text-decoration: none; }\n.walue-card { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); margin-bottom: 1.5rem; }\n.walue-card .card-header { background: white; border-bottom: 1px solid rgba(0,0,0,0.05); border-radius: 16px 16px 0 0 !important; padding: 1.25rem 1.5rem; }\n.walue-card .card-body { padding: 1.5rem; }\n.walue-card.border-success .card-header { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; }\n.step-number { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; }\n.step-number.bg-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important; color: white; }\n.step-number.bg-secondary { background: linear-gradient(135deg, #6c757d 0%, #495057 100%) !important; color: white; }\n.btn-walue { border-radius: 10px; font-weight: 600; padding: 0.8rem 2rem; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border: none; color: white; }\n.btn-walue:hover { background: linear-gradient(135deg, var(--primary-dark) 0%, var(--secondary) 100%); color: white; }\n.btn-outline-walue { border-radius: 10px; font-weight: 600; padding: 0.8rem 2rem; background: transparent; border: 2px solid var(--primary-dark); color: var(--primary-dark); }\n.btn-outline-walue:hover { background: var(--primary); border-color: var(--primary); color: white; }\n.code-block { background: var(--dark); border-radius: 12px; padding: 1.25rem; font-family: monospace; font-size: 13px; line-height: 1.8; color: #e9ecef; white-space: pre-wrap; }\n.code-block .text-warning { color: #ffc107 !important; }\n.form-control { border-radius: 10px; padding: 0.75rem 1rem; border: 2px solid #e9ecef; }\n.walue-footer { background: var(--dark) !important; color: white; padding: 1.5rem 0; margin-top: 3rem; }\n.success-icon { animation: bounce 1s ease; }\n@keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-20px); } 60% { transform: translateY(-10px); } }\n.toast-notification { position: fixed; top: 20px; right: 20px; padding: 14px 24px; border-radius: 12px; color: white; font-weight: 600; z-index: 9999; opacity: 0; transform: translateX(100px); transition: all 0.3s ease; }\n.toast-notification.show { opacity: 1; transform: translateX(0); }\n.toast-notification.toast-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); }\n.toast-notification.toast-error { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); }\n.font-monospace { font-family: monospace !important; font-size: 12px; }\n</style>\n\n<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<!-- Navigation -->\n<nav class=\"walue-navbar\">\n    <div class=\"container\">\n        <a class=\"navbar-brand\" href=\"/walue\"><i class=\"fab fa-whatsapp me-2\"></i>Walue</a>\n    </div>\n</nav>\n\n<!-- Success Content -->\n<div class=\"container py-5\">\n    <div class=\"row justify-content-center\">\n        <div class=\"col-lg-8\">\n            <!-- Success Header -->\n            <div class=\"text-center mb-5\">\n                <div class=\"success-icon mb-4\">\n                    <i class=\"fas fa-check-circle text-success\" style=\"font-size: 80px;\"></i>\n                </div>\n                <h1 class=\"text-success\">WhatsApp Business Account Created!</h1>\n                <p class=\"lead text-muted\">Your WABA has been successfully connected. Now let's configure your Frappe app.</p>\n            </div>\n\n            <!-- WABA Details Card -->\n            <div class=\"walue-card card border-success mb-4\">\n                <div class=\"card-header\">\n                    <h5 class=\"mb-0\"><i class=\"fab fa-whatsapp me-2\"></i>Your WhatsApp Business Account</h5>\n                </div>\n                <div class=\"card-body\">\n                    <div class=\"row\">\n                        <div class=\"col-md-6\">\n                            <p><strong>Phone Number:</strong> <span id=\"waba-phone\" class=\"text-success fw-bold\">Loading...</span></p>\n                            <p><strong>WABA ID:</strong> <span id=\"waba-id\" class=\"font-monospace\">Loading...</span></p>\n                        </div>\n                        <div class=\"col-md-6\">\n                            <p><strong>Company:</strong> <span id=\"customer-name\">Loading...</span></p>\n                            <p><strong>Status:</strong> <span class=\"badge bg-success\">Active</span></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Setup Instructions -->\n            <div class=\"walue-card card mb-4\">\n                <div class=\"card-header bg-white\">\n                    <h5 class=\"mb-0\"><i class=\"fas fa-tasks me-2\"></i>Next Steps</h5>\n                </div>\n                <div class=\"card-body\">\n                    <!-- Step 1 -->\n                    <div class=\"step-item mb-4\">\n                        <div class=\"d-flex\">\n                            <div class=\"step-number bg-success\">1</div>\n                            <div class=\"ms-3\">\n                                <h6>Install the App on Your Frappe Site</h6>\n                                <p class=\"text-muted small mb-2\">Run these commands on your Frappe server:</p>\n                                <div class=\"code-block\">bench get-app https://github.com/walue-biz/walue-whatsapp-client\nbench --site <span class=\"text-warning\" id=\"site-domain\">your-site.com</span> install-app walue_whatsapp_client\nbench restart</div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Step 2 -->\n                    <div class=\"step-item mb-4\">\n                        <div class=\"d-flex\">\n                            <div class=\"step-number bg-success\">2</div>\n                            <div class=\"ms-3\">\n                                <h6>Auto-Configure with Setup Link (Recommended)</h6>\n                                <p class=\"text-muted small mb-2\">Click this link while logged into your Frappe site:</p>\n                                <div class=\"input-group mb-2\">\n                                    <input type=\"text\" class=\"form-control\" id=\"setup-link\" readonly>\n                                    <button class=\"btn btn-outline-success\" onclick=\"copyToClipboard('setup-link')\"><i class=\"fas fa-copy\"></i></button>\n                                    <a class=\"btn btn-walue\" id=\"setup-link-btn\" href=\"#\" target=\"_blank\"><i class=\"fas fa-external-link-alt me-1\"></i>Open Setup Link</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Step 3 (Alternative) -->\n                    <div class=\"step-item\">\n                        <div class=\"d-flex\">\n                            <div class=\"step-number bg-secondary\">Alt</div>\n                            <div class=\"ms-3\">\n                                <h6>Or: Manual Token Entry</h6>\n                                <p class=\"text-muted small mb-2\">If the link doesn't work, copy this token and paste it in WhatsApp Settings:</p>\n                                <div class=\"input-group\">\n                                    <input type=\"text\" class=\"form-control font-monospace\" id=\"setup-token\" readonly>\n                                    <button class=\"btn btn-outline-success\" onclick=\"copyToClipboard('setup-token')\"><i class=\"fas fa-copy me-1\"></i>Copy</button>\n                                </div>\n                                <small class=\"text-muted mt-1 d-block\"><i class=\"fas fa-clock me-1\"></i>Token expires: <span id=\"token-expiry\">-</span></small>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Actions -->\n            <div class=\"text-center\">\n                <a href=\"/walue-dashboard\" class=\"btn btn-outline-walue btn-lg me-2\">\n                    <i class=\"fas fa-tachometer-alt me-2\"></i>Go to Dashboard\n                </a>\n                <a href=\"#\" id=\"frappe-site-link\" target=\"_blank\" class=\"btn btn-walue btn-lg\">\n                    <i class=\"fas fa-external-link-alt me-2\"></i>Open Your Frappe Site\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n\n<!-- Footer -->\n<footer class=\"walue-footer text-center\">\n    <div class=\"container\"><p class=\"mb-0 opacity-75\">&copy; 2025 Walue Biz. WhatsApp Business Solution Provider.</p></div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n<script>\nconst PROVIDER_URL = window.location.origin;\nconst STORAGE_KEYS = { CUSTOMER_ID: 'walue_customer_id', CUSTOMER_DATA: 'walue_customer_data', SESSION_ID: 'walue_session_id' };\n\nasync function apiCall(endpoint, method, data) {\n    const url = PROVIDER_URL + '/api/method/' + endpoint;\n    const options = { method: method, headers: { 'Content-Type': 'application/json' } };\n    if (data && method !== 'GET') options.body = JSON.stringify(data);\n    const response = await fetch(url, options);\n    const result = await response.json();\n    return result.message || result;\n}\n\nfunction getCustomerData() {\n    const data = localStorage.getItem(STORAGE_KEYS.CUSTOMER_DATA);\n    return data ? JSON.parse(data) : null;\n}\n\nfunction saveCustomerData(data) {\n    localStorage.setItem(STORAGE_KEYS.CUSTOMER_DATA, JSON.stringify(data));\n    if (data.customer_id) localStorage.setItem(STORAGE_KEYS.CUSTOMER_ID, data.customer_id);\n}\n\nfunction formatDate(dateString) {\n    if (!dateString) return '-';\n    const date = new Date(dateString);\n    return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();\n}\n\nfunction showToast(message, type) {\n    const toast = document.createElement('div');\n    toast.className = 'toast-notification toast-' + type;\n    toast.innerHTML = '<i class=\"fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + ' me-2\"></i>' + message;\n    document.body.appendChild(toast);\n    setTimeout(function() { toast.classList.add('show'); }, 10);\n    setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 300); }, 3000);\n}\n\nfunction copyToClipboard(elementId) {\n    const element = document.getElementById(elementId);\n    if (element) {\n        navigator.clipboard.writeText(element.value).then(function() { showToast('Copied to clipboard!', 'success'); });\n    }\n}\n\ndocument.addEventListener('DOMContentLoaded', async function() {\n    const urlParams = new URLSearchParams(window.location.search);\n    const customerId = urlParams.get('customer_id');\n    const sessionId = urlParams.get('session_id');\n    const storedData = getCustomerData();\n    if (!customerId && !sessionId && !storedData) { window.location.href = '/walue'; return; }\n    await loadSuccessPageInfo(customerId, sessionId, storedData);\n});\n\nasync function loadSuccessPageInfo(customerId, sessionId, storedData) {\n    try {\n        var params = '';\n        if (sessionId) params = 'session_id=' + sessionId;\n        else if (customerId) params = 'customer_id=' + customerId;\n        else if (storedData && storedData.customer_id) params = 'customer_id=' + storedData.customer_id;\n        \n        const result = await apiCall('walue_whatsapp_provider.api.setup.get_setup_info?' + params, 'GET');\n        if (result.success) {\n            document.getElementById('waba-phone').textContent = result.phone_number || 'N/A';\n            document.getElementById('waba-id').textContent = result.waba_id || 'N/A';\n            document.getElementById('customer-name').textContent = result.customer_name || 'N/A';\n            \n            var siteUrl = result.frappe_site_url || (storedData ? storedData.frappe_site_url : '') || '';\n            var siteDomain = siteUrl.replace('https://', '').replace('http://', '').replace(/\\/$/, '');\n            document.getElementById('site-domain').textContent = siteDomain || 'your-site.com';\n            \n            if (result.setup_token && !result.setup_token_used) {\n                document.getElementById('setup-token').value = result.setup_token;\n                document.getElementById('setup-link').value = result.setup_link || '';\n                document.getElementById('setup-link-btn').href = result.setup_link || '#';\n                document.getElementById('token-expiry').textContent = formatDate(result.setup_token_expiry);\n            } else {\n                document.getElementById('setup-token').value = 'Token already used';\n                document.getElementById('setup-link').value = 'Token already used';\n                document.getElementById('setup-link-btn').style.display = 'none';\n            }\n            \n            if (siteUrl) document.getElementById('frappe-site-link').href = siteUrl;\n            \n            var updatedData = Object.assign({}, storedData || {}, {\n                customer_id: customerId || (storedData ? storedData.customer_id : null),\n                phone_number: result.phone_number, waba_id: result.waba_id,\n                customer_name: result.customer_name, embedded_signup_completed: true\n            });\n            saveCustomerData(updatedData);\n        } else { showToast('Could not load setup info. Please go to dashboard.', 'error'); }\n    } catch (error) {\n        console.error('Failed to load success page info:', error);\n        if (storedData) {\n            document.getElementById('customer-name').textContent = storedData.customer_name || 'N/A';\n            var siteUrl = storedData.frappe_site_url || '';\n            var siteDomain = siteUrl.replace('https://', '').replace('http://', '').replace(/\\/$/, '');\n            document.getElementById('site-domain').textContent = siteDomain || 'your-site.com';\n            if (siteUrl) document.getElementById('frappe-site-link').href = siteUrl;\n        }\n        showToast('Could not connect to server. Some info may be incomplete.', 'error');\n    }\n}\n</script>"
  }
]
