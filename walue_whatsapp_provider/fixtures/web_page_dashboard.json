[
  {
    "doctype": "Web Page",
    "name": "walue-dashboard",
    "title": "Dashboard - Walue WhatsApp",
    "route": "walue-dashboard",
    "published": 1,
    "module": "Walue WhatsApp Provider",
    "content_type": "HTML",
    "show_title": 0,
    "full_width": 1,
    "main_section": "<style>\n:root {\n    --primary: #25D366;\n    --primary-dark: #128C7E;\n    --secondary: #075E54;\n    --dark: #1a1a2e;\n    --light-bg: #f8fafc;\n}\nbody { font-family: 'Inter', -apple-system, sans-serif; background-color: var(--light-bg); min-height: 100vh; }\n.walue-navbar { padding: 1rem 0; background: linear-gradient(135deg, var(--secondary) 0%, var(--primary-dark) 100%) !important; }\n.walue-navbar .navbar-brand { font-weight: 700; font-size: 1.4rem; color: white; text-decoration: none; }\n.walue-navbar .nav-link { color: rgba(255,255,255,0.9); text-decoration: none; }\n.page-header { background: linear-gradient(135deg, var(--dark) 0%, #16213e 100%); color: white; padding: 2rem 0; margin-bottom: 2rem; }\n.page-header h2 { color: white; margin: 0; font-weight: 700; }\n.page-header p { color: rgba(255,255,255,0.7); margin: 0; }\n.walue-card { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); margin-bottom: 1.5rem; }\n.walue-card .card-header { background: white; border-bottom: 1px solid rgba(0,0,0,0.05); border-radius: 16px 16px 0 0 !important; padding: 1.25rem 1.5rem; display: flex; align-items: center; }\n.walue-card .card-body { padding: 1.5rem; }\n.status-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n.status-icon.bg-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important; }\n.status-icon.bg-warning { background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%) !important; }\n.status-icon.bg-secondary { background: linear-gradient(135deg, #6c757d 0%, #495057 100%) !important; }\n.step-number { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; }\n.step-number.bg-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important; color: white; }\n.step-number.bg-secondary { background: linear-gradient(135deg, #6c757d 0%, #495057 100%) !important; color: white; }\n.btn-walue { border-radius: 10px; font-weight: 600; padding: 0.8rem 2rem; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border: none; color: white; }\n.btn-walue:hover { background: linear-gradient(135deg, var(--primary-dark) 0%, var(--secondary) 100%); color: white; }\n.code-block { background: var(--dark); border-radius: 12px; padding: 1.25rem; font-family: monospace; font-size: 13px; line-height: 1.8; color: #e9ecef; white-space: pre-wrap; }\n.code-block .text-warning { color: #ffc107 !important; }\n.form-control { border-radius: 10px; padding: 0.75rem 1rem; border: 2px solid #e9ecef; }\n.form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.15); }\n.walue-footer { background: var(--dark) !important; color: white; padding: 1.5rem 0; margin-top: auto; }\n.toast-notification { position: fixed; top: 20px; right: 20px; padding: 14px 24px; border-radius: 12px; color: white; font-weight: 600; z-index: 9999; opacity: 0; transform: translateX(100px); transition: all 0.3s ease; }\n.toast-notification.show { opacity: 1; transform: translateX(0); }\n.toast-notification.toast-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); }\n.toast-notification.toast-error { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); }\n.toast-notification.toast-info { background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%); }\n.font-monospace { font-family: monospace !important; font-size: 12px; }\n</style>\n\n<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<!-- Navigation -->\n<nav class=\"walue-navbar\">\n    <div class=\"container d-flex justify-content-between align-items-center\">\n        <a class=\"navbar-brand\" href=\"/walue\"><i class=\"fab fa-whatsapp me-2\"></i>Walue</a>\n        <div>\n            <span class=\"nav-link d-inline\" id=\"customer-name-nav\"></span>\n            <a class=\"nav-link d-inline ms-3\" href=\"#\" onclick=\"logout()\"><i class=\"fas fa-sign-out-alt\"></i></a>\n        </div>\n    </div>\n</nav>\n\n<!-- Page Header -->\n<div class=\"page-header\">\n    <div class=\"container\">\n        <h2><i class=\"fas fa-th-large me-2\"></i>Dashboard</h2>\n        <p>Setup and manage your WhatsApp integration</p>\n    </div>\n</div>\n\n<!-- Dashboard Content -->\n<div class=\"container pb-5\">\n    <div id=\"no-customer-alert\" class=\"alert alert-warning\" style=\"display: none;\">\n        <i class=\"fas fa-exclamation-triangle me-2\"></i>\n        No registration found. <a href=\"/walue\">Register first</a> to continue.\n    </div>\n\n    <div id=\"dashboard-content\" style=\"display: none;\">\n        <!-- Status Cards -->\n        <div class=\"row g-4 mb-4\">\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"status-icon bg-secondary text-white\" id=\"registration-status-icon\"><i class=\"fas fa-spinner fa-spin\"></i></div>\n                            <div class=\"ms-3\">\n                                <h6 class=\"mb-1\">Registration</h6>\n                                <small class=\"text-muted\" id=\"registration-status-text\">Checking...</small>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"status-icon bg-secondary text-white\" id=\"waba-status-icon\"><i class=\"fas fa-spinner fa-spin\"></i></div>\n                            <div class=\"ms-3\">\n                                <h6 class=\"mb-1\">WhatsApp Account</h6>\n                                <small class=\"text-muted\" id=\"waba-status-text\">Checking...</small>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"status-icon bg-secondary text-white\" id=\"app-status-icon\"><i class=\"fas fa-spinner fa-spin\"></i></div>\n                            <div class=\"ms-3\">\n                                <h6 class=\"mb-1\">App Setup</h6>\n                                <small class=\"text-muted\" id=\"app-status-text\">Checking...</small>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Step 1: Connect WABA -->\n        <div class=\"walue-card card\" id=\"step-waba\">\n            <div class=\"card-header\">\n                <span class=\"step-number bg-success\">1</span>\n                <h5 class=\"mb-0 ms-3\">Connect WhatsApp Business Account</h5>\n                <span class=\"badge bg-warning ms-auto\" id=\"waba-badge\">Pending</span>\n            </div>\n            <div class=\"card-body\">\n                <div id=\"waba-action\">\n                    <p class=\"text-muted mb-4\">Create or connect your WhatsApp Business Account through Meta's secure signup.</p>\n                    <button class=\"btn btn-walue btn-lg\" onclick=\"initiateEmbeddedSignup()\">\n                        <i class=\"fab fa-whatsapp me-2\"></i>Connect WhatsApp\n                    </button>\n                </div>\n                <div id=\"waba-completed\" style=\"display: none;\">\n                    <div class=\"alert alert-success mb-0\">\n                        <i class=\"fas fa-check-circle me-2\"></i>\n                        <strong>Connected!</strong> Phone: <span id=\"waba-phone\"></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Step 2: Install App -->\n        <div class=\"walue-card card\" id=\"step-install\">\n            <div class=\"card-header\">\n                <span class=\"step-number bg-secondary\">2</span>\n                <h5 class=\"mb-0 ms-3\">Install App</h5>\n                <span class=\"badge bg-secondary ms-auto\" id=\"install-badge\">Pending</span>\n            </div>\n            <div class=\"card-body\">\n                <p class=\"text-muted mb-3\">Run these commands on your Frappe server:</p>\n                <div class=\"code-block mb-3\" id=\"install-commands\">bench get-app https://github.com/walue-biz/walue-whatsapp-client\nbench --site <span class=\"text-warning\" id=\"site-placeholder\">your-site.com</span> install-app walue_whatsapp_client\nbench restart</div>\n                <button class=\"btn btn-outline-secondary btn-sm\" onclick=\"copyInstallCommands()\">\n                    <i class=\"fas fa-copy me-2\"></i>Copy\n                </button>\n            </div>\n        </div>\n\n        <!-- Step 3: Configure -->\n        <div class=\"walue-card card\" id=\"step-configure\">\n            <div class=\"card-header\">\n                <span class=\"step-number bg-secondary\">3</span>\n                <h5 class=\"mb-0 ms-3\">Configure</h5>\n                <span class=\"badge bg-secondary ms-auto\" id=\"configure-badge\">Pending</span>\n            </div>\n            <div class=\"card-body\">\n                <p class=\"text-muted mb-4\">Use one of these options to configure your app:</p>\n                <div class=\"mb-4\">\n                    <label class=\"form-label\"><i class=\"fas fa-link me-2\"></i>One-Click Setup</label>\n                    <div class=\"input-group\">\n                        <input type=\"text\" class=\"form-control font-monospace\" id=\"setup-link\" readonly placeholder=\"Complete step 1 first...\">\n                        <button class=\"btn btn-outline-success\" onclick=\"copySetupLink()\"><i class=\"fas fa-copy\"></i></button>\n                        <a class=\"btn btn-walue\" id=\"setup-link-btn\" href=\"#\" target=\"_blank\">Open <i class=\"fas fa-external-link-alt ms-1\"></i></a>\n                    </div>\n                </div>\n                <div>\n                    <label class=\"form-label\"><i class=\"fas fa-key me-2\"></i>Manual Token</label>\n                    <div class=\"input-group\">\n                        <input type=\"text\" class=\"form-control font-monospace\" id=\"setup-token\" readonly placeholder=\"Complete step 1 first...\">\n                        <button class=\"btn btn-outline-success\" onclick=\"copySetupToken()\"><i class=\"fas fa-copy me-1\"></i>Copy</button>\n                    </div>\n                    <small class=\"text-muted mt-2 d-block\"><i class=\"fas fa-clock me-1\"></i>Expires: <span id=\"token-expiry\">-</span></small>\n                </div>\n                <div id=\"token-used-warning\" class=\"alert alert-warning mt-3\" style=\"display: none;\">\n                    <i class=\"fas fa-exclamation-triangle me-2\"></i>Token already used. Contact support if you need to reconfigure.\n                </div>\n            </div>\n        </div>\n\n        <!-- Account Details -->\n        <div class=\"walue-card card\">\n            <div class=\"card-header\"><h5 class=\"mb-0\"><i class=\"fas fa-user-circle me-2\"></i>Account</h5></div>\n            <div class=\"card-body\">\n                <div class=\"row\">\n                    <div class=\"col-md-6\">\n                        <table class=\"table table-borderless table-sm mb-0\">\n                            <tr><th>ID</th><td id=\"detail-customer-id\">-</td></tr>\n                            <tr><th>Company</th><td id=\"detail-customer-name\">-</td></tr>\n                            <tr><th>Email</th><td id=\"detail-email\">-</td></tr>\n                        </table>\n                    </div>\n                    <div class=\"col-md-6\">\n                        <table class=\"table table-borderless table-sm mb-0\">\n                            <tr><th>Site</th><td id=\"detail-site-url\">-</td></tr>\n                            <tr><th>Plan</th><td id=\"detail-plan\">-</td></tr>\n                            <tr><th>Status</th><td id=\"detail-status\">-</td></tr>\n                        </table>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<!-- Footer -->\n<footer class=\"walue-footer text-center\">\n    <div class=\"container\"><p class=\"mb-0 opacity-75\">&copy; 2025 Walue Biz</p></div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n<script>\nconst PROVIDER_URL = window.location.origin;\nconst STORAGE_KEYS = { CUSTOMER_ID: 'walue_customer_id', CUSTOMER_DATA: 'walue_customer_data', SESSION_ID: 'walue_session_id' };\nlet customerData = null;\nlet FB_APP_ID = null;\nlet FB_CONFIG_ID = null;\n\nasync function apiCall(endpoint, method, data) {\n    const url = PROVIDER_URL + '/api/method/' + endpoint;\n    const options = { method: method, headers: { 'Content-Type': 'application/json' } };\n    if (data && method !== 'GET') options.body = JSON.stringify(data);\n    const response = await fetch(url, options);\n    const result = await response.json();\n    return result.message || result;\n}\n\nfunction saveCustomerData(data) {\n    localStorage.setItem(STORAGE_KEYS.CUSTOMER_DATA, JSON.stringify(data));\n    if (data.customer_id) localStorage.setItem(STORAGE_KEYS.CUSTOMER_ID, data.customer_id);\n}\n\nfunction getCustomerData() {\n    const data = localStorage.getItem(STORAGE_KEYS.CUSTOMER_DATA);\n    return data ? JSON.parse(data) : null;\n}\n\nfunction clearCustomerData() {\n    localStorage.removeItem(STORAGE_KEYS.CUSTOMER_DATA);\n    localStorage.removeItem(STORAGE_KEYS.CUSTOMER_ID);\n    localStorage.removeItem(STORAGE_KEYS.SESSION_ID);\n}\n\nfunction logout() { clearCustomerData(); window.location.href = '/walue'; }\n\nfunction showToast(message, type) {\n    const toast = document.createElement('div');\n    toast.className = 'toast-notification toast-' + type;\n    toast.innerHTML = '<i class=\"fas fa-' + (type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle') + ' me-2\"></i>' + message;\n    document.body.appendChild(toast);\n    setTimeout(function() { toast.classList.add('show'); }, 10);\n    setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 300); }, 3000);\n}\n\nfunction formatDate(dateString) {\n    if (!dateString) return '-';\n    const date = new Date(dateString);\n    return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();\n}\n\nfunction copyToClipboard(elementId) {\n    const element = document.getElementById(elementId);\n    if (element) {\n        navigator.clipboard.writeText(element.value).then(function() {\n            showToast('Copied to clipboard!', 'success');\n        });\n    }\n}\n\nfunction copySetupToken() { copyToClipboard('setup-token'); }\nfunction copySetupLink() { copyToClipboard('setup-link'); }\nfunction copyInstallCommands() {\n    const commands = document.getElementById('install-commands').innerText;\n    navigator.clipboard.writeText(commands).then(function() { showToast('Commands copied to clipboard!', 'success'); });\n}\n\ndocument.addEventListener('DOMContentLoaded', async function() {\n    customerData = getCustomerData();\n    if (!customerData || !customerData.customer_id) {\n        document.getElementById('no-customer-alert').style.display = 'block';\n        document.getElementById('dashboard-content').style.display = 'none';\n        return;\n    }\n    document.getElementById('no-customer-alert').style.display = 'none';\n    document.getElementById('dashboard-content').style.display = 'block';\n    document.getElementById('customer-name-nav').textContent = customerData.customer_name;\n    await loadFacebookConfig();\n    initFacebookSDK();\n    setupSessionInfoListener();\n    await updateDashboardStatus();\n});\n\nasync function loadFacebookConfig() {\n    try {\n        const result = await apiCall('walue_whatsapp_provider.api.embedded_signup.get_config', 'GET');\n        if (result.success) { FB_APP_ID = result.app_id; FB_CONFIG_ID = result.config_id; }\n    } catch (error) { console.error('Failed to load Facebook config:', error); }\n}\n\nfunction initFacebookSDK() {\n    if (!document.getElementById('facebook-jssdk')) {\n        const script = document.createElement('script');\n        script.id = 'facebook-jssdk';\n        script.src = 'https://connect.facebook.net/en_US/sdk.js';\n        script.async = true; script.defer = true; script.crossOrigin = 'anonymous';\n        document.head.appendChild(script);\n    }\n    window.fbAsyncInit = function() {\n        if (FB_APP_ID) { FB.init({ appId: FB_APP_ID, autoLogAppEvents: true, xfbml: true, version: 'v24.0' }); }\n    };\n}\n\nfunction setupSessionInfoListener() {\n    window.addEventListener('message', function(event) {\n        if (event.origin !== 'https://www.facebook.com' && event.origin !== 'https://web.facebook.com') return;\n        try {\n            const data = JSON.parse(event.data);\n            if (data.type === 'WA_EMBEDDED_SIGNUP') {\n                if (data.event === 'FINISH' || data.event === 'FINISH_ONLY_WABA') {\n                    window.embeddedSignupWabaData = data.data;\n                    if (window.embeddedSignupCode || window.embeddedSignupAccessToken) { handleEmbeddedSignupComplete(data.data); }\n                } else if (data.event === 'CANCEL') { showToast('WhatsApp signup was cancelled', 'info'); resetConnectButton(); }\n                else if (data.event === 'ERROR') { showToast('Error during signup', 'error'); resetConnectButton(); }\n            }\n        } catch (e) {}\n    });\n}\n\nasync function handleEmbeddedSignupComplete(data) {\n    const wabaId = data.waba_id;\n    const phoneNumberId = data.phone_number_id;\n    const sessionId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);\n    const code = window.embeddedSignupCode;\n    const accessToken = window.embeddedSignupAccessToken;\n    if (!wabaId) { showToast('Failed to get WhatsApp Business Account ID', 'error'); resetConnectButton(); return; }\n    try {\n        showToast('Completing signup...', 'info');\n        const result = await apiCall('walue_whatsapp_provider.api.embedded_signup.complete', 'POST', {\n            customer_id: customerData.customer_id, session_id: sessionId, waba_id: wabaId,\n            phone_number_id: phoneNumberId, code: code || null, access_token: accessToken || null\n        });\n        if (result.success) {\n            showToast('WhatsApp Business Account connected successfully!', 'success');\n            customerData.waba_id = wabaId; customerData.phone_number_id = phoneNumberId;\n            customerData.embedded_signup_completed = true; customerData.phone_number = result.phone_number;\n            customerData.setup_token = result.setup_token; saveCustomerData(customerData);\n            window.embeddedSignupCode = null; window.embeddedSignupAccessToken = null; window.embeddedSignupWabaData = null;\n            await updateDashboardStatus(); resetConnectButton();\n        } else { showToast(result.error || 'Failed to complete signup', 'error'); resetConnectButton(); }\n    } catch (error) { showToast('Failed to complete signup. Please try again.', 'error'); resetConnectButton(); }\n}\n\nfunction resetConnectButton() {\n    const btn = document.querySelector('#waba-action button');\n    if (btn) { btn.disabled = false; btn.innerHTML = '<i class=\"fab fa-whatsapp me-2\"></i>Connect WhatsApp'; }\n}\n\nasync function updateDashboardStatus() {\n    updateCustomerDetails();\n    const siteUrl = customerData.frappe_site_url || '';\n    const siteDomain = siteUrl.replace('https://', '').replace('http://', '').replace(/\\/$/, '');\n    document.getElementById('site-placeholder').textContent = siteDomain || 'your-site.com';\n    updateStatusCard('registration', true, 'Complete');\n    const wabaConnected = customerData.waba_id || customerData.embedded_signup_completed;\n    if (wabaConnected) {\n        updateStatusCard('waba', true, 'Connected');\n        document.getElementById('waba-badge').className = 'badge bg-success ms-auto';\n        document.getElementById('waba-badge').textContent = 'Complete';\n        document.getElementById('waba-action').style.display = 'none';\n        document.getElementById('waba-completed').style.display = 'block';\n        document.getElementById('waba-phone').textContent = customerData.phone_number || 'N/A';\n        document.querySelector('#step-install .step-number').className = 'step-number bg-success';\n        document.querySelector('#step-configure .step-number').className = 'step-number bg-success';\n        await loadSetupInfo();\n    } else {\n        updateStatusCard('waba', false, 'Not Connected');\n        document.getElementById('waba-badge').className = 'badge bg-warning ms-auto';\n        document.getElementById('waba-badge').textContent = 'Pending';\n    }\n    const setupUsed = customerData.setup_token_used;\n    if (setupUsed) {\n        updateStatusCard('app', true, 'Configured');\n        document.getElementById('configure-badge').className = 'badge bg-success ms-auto';\n        document.getElementById('configure-badge').textContent = 'Complete';\n    } else {\n        updateStatusCard('app', false, 'Not Configured');\n        document.getElementById('configure-badge').className = 'badge bg-warning ms-auto';\n        document.getElementById('configure-badge').textContent = 'Pending';\n    }\n}\n\nfunction updateStatusCard(type, success, text) {\n    const iconEl = document.getElementById(type + '-status-icon');\n    const textEl = document.getElementById(type + '-status-text');\n    if (success) { iconEl.className = 'status-icon bg-success'; iconEl.innerHTML = '<i class=\"fas fa-check text-white\"></i>'; }\n    else { iconEl.className = 'status-icon bg-warning'; iconEl.innerHTML = '<i class=\"fas fa-exclamation text-white\"></i>'; }\n    textEl.textContent = text;\n}\n\nfunction updateCustomerDetails() {\n    document.getElementById('detail-customer-id').textContent = customerData.customer_id || '-';\n    document.getElementById('detail-customer-name').textContent = customerData.customer_name || '-';\n    document.getElementById('detail-email').textContent = customerData.company_email || '-';\n    document.getElementById('detail-site-url').textContent = customerData.frappe_site_url || '-';\n    document.getElementById('detail-plan').textContent = customerData.subscription_plan || 'Not selected';\n    document.getElementById('detail-status').textContent = customerData.status || 'Pending';\n}\n\nasync function loadSetupInfo() {\n    try {\n        const sessionId = localStorage.getItem(STORAGE_KEYS.SESSION_ID);\n        const params = sessionId ? 'session_id=' + sessionId : 'customer_id=' + customerData.customer_id;\n        const result = await apiCall('walue_whatsapp_provider.api.setup.get_setup_info?' + params, 'GET');\n        if (result.success) {\n            if (result.setup_token && !result.setup_token_used) {\n                document.getElementById('setup-token').value = result.setup_token;\n                document.getElementById('setup-link').value = result.setup_link || '';\n                document.getElementById('setup-link-btn').href = result.setup_link || '#';\n                document.getElementById('token-expiry').textContent = formatDate(result.setup_token_expiry);\n            } else if (result.setup_token_used) {\n                document.getElementById('setup-token').value = 'Token already used';\n                document.getElementById('setup-link').value = 'Token already used';\n                document.getElementById('token-used-warning').style.display = 'block';\n            }\n            customerData = Object.assign({}, customerData, { phone_number: result.phone_number, waba_id: result.waba_id, setup_token_used: result.setup_token_used });\n            saveCustomerData(customerData);\n        }\n    } catch (error) { console.error('Failed to load setup info:', error); }\n}\n\nasync function initiateEmbeddedSignup() {\n    const btn = event.target;\n    btn.disabled = true;\n    btn.innerHTML = '<i class=\"fas fa-spinner fa-spin me-2\"></i>Loading...';\n    if (typeof FB === 'undefined') { showToast('Facebook SDK not loaded. Please refresh the page.', 'error'); resetConnectButton(); return; }\n    if (!FB_APP_ID || !FB_CONFIG_ID) { showToast('Configuration not loaded. Please refresh the page.', 'error'); resetConnectButton(); return; }\n    try {\n        const initResult = await apiCall('walue_whatsapp_provider.api.embedded_signup.initiate', 'POST', { customer_id: customerData.customer_id });\n        if (!initResult.success) { showToast(initResult.error || 'Failed to start signup', 'error'); resetConnectButton(); return; }\n        localStorage.setItem(STORAGE_KEYS.SESSION_ID, initResult.session_id);\n        FB.login(function(response) {\n            if (response.authResponse) {\n                window.embeddedSignupCode = response.authResponse.code || null;\n                window.embeddedSignupAccessToken = response.authResponse.accessToken || null;\n                if (window.embeddedSignupWabaData) { handleEmbeddedSignupComplete(window.embeddedSignupWabaData); }\n                else { showToast('Processing signup...', 'info'); setTimeout(function() { if (!window.embeddedSignupWabaData && !customerData.embedded_signup_completed) { showToast('Signup may have completed. Please refresh the page.', 'info'); resetConnectButton(); } }, 30000); }\n            } else { showToast('Login was cancelled or failed', 'error'); resetConnectButton(); }\n        }, { config_id: FB_CONFIG_ID, response_type: 'code', override_default_response_type: true, extras: { version: 'v3' } });\n    } catch (error) { showToast('Could not connect to server. Please try again.', 'error'); resetConnectButton(); }\n}\n</script>"
  }
]
