    "full_width": 1,
    "main_section": "<style>\n:root {\n    --primary: #25D366;\n    --primary-dark: #128C7E;\n    --secondary: #075E54;\n    --dark: #1a1a2e;\n    --light-bg: #f8fafc;\n}\nbody { font-family: 'Inter', -apple-system, sans-serif; background-color: var(--light-bg); }\n.walue-navbar { padding: 1rem 0; background: linear-gradient(135deg, var(--secondary) 0%, var(--primary-dark) 100%) !important; }\n.walue-navbar .navbar-brand { font-weight: 700; font-size: 1.4rem; color: white; text-decoration: none; }\n.walue-navbar .nav-link { color: rgba(255,255,255,0.9); }\n.hero-section { background: linear-gradient(135deg, var(--dark) 0%, #16213e 100%); color: white; padding: 4rem 0 !important; position: relative; overflow: hidden; }\n.hero-section::before { content: ''; position: absolute; top: -50%; right: -20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(37, 211, 102, 0.15) 0%, transparent 70%); border-radius: 50%; }\n.hero-section h1 { font-weight: 800; letter-spacing: -1px; font-size: 3rem; background: linear-gradient(135deg, #fff 0%, var(--primary) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }\n.hero-section .lead { color: rgba(255,255,255,0.8); font-size: 1.1rem; line-height: 1.7; }\n.hero-section .feature-list li { color: rgba(255,255,255,0.9); padding: 0.5rem 0; list-style: none; }\n.hero-section .feature-list i { color: var(--primary); }\n.walue-card { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }\n.walue-card .card-header { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); color: white; border: none; border-radius: 16px 16px 0 0 !important; padding: 1.25rem 1.5rem; }\n.walue-card .card-body { padding: 1.5rem; }\n.feature-icon { width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; font-size: 28px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border-radius: 16px; color: white; margin: 0 auto 1rem; }\n.btn-walue { border-radius: 10px; font-weight: 600; padding: 0.8rem 2rem; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); border: none; color: white; }\n.btn-walue:hover { background: linear-gradient(135deg, var(--primary-dark) 0%, var(--secondary) 100%); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4); color: white; }\n.form-control, .form-select { border-radius: 10px; padding: 0.75rem 1rem; border: 2px solid #e9ecef; }\n.form-control:focus, .form-select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.15); }\n.form-label { font-weight: 600; color: #555; font-size: 0.9rem; }\n.features-section { background: white; padding: 4rem 0; }\n.features-section h2 { font-weight: 700; margin-bottom: 3rem; text-align: center; }\n.walue-footer { background: var(--dark) !important; color: white; padding: 1.5rem 0; }\n.toast-notification { position: fixed; top: 20px; right: 20px; padding: 14px 24px; border-radius: 12px; color: white; font-weight: 600; z-index: 9999; opacity: 0; transform: translateX(100px); transition: all 0.3s ease; }\n.toast-notification.show { opacity: 1; transform: translateX(0); }\n.toast-notification.toast-success { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); }\n.toast-notification.toast-error { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); }\n@media (max-width: 768px) { .hero-section { padding: 2.5rem 0 !important; } .hero-section h1 { font-size: 2rem; } }\n</style>\n\n<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<!-- Navigation -->\n<nav class=\"walue-navbar\">\n    <div class=\"container d-flex justify-content-between align-items-center\">\n        <a class=\"navbar-brand\" href=\"/walue\">\n            <i class=\"fab fa-whatsapp me-2\"></i>Walue\n        </a>\n        <a class=\"nav-link\" href=\"/walue-dashboard\">Dashboard</a>\n    </div>\n</nav>\n\n<!-- Hero Section -->\n<section class=\"hero-section\">\n    <div class=\"container\">\n        <div class=\"row align-items-center g-5\">\n            <div class=\"col-lg-6\">\n                <h1 class=\"mb-4\">WhatsApp Business API</h1>\n                <p class=\"lead mb-4\">\n                    Connects WhatsApp to your Frappe/ERPNext system. Send messages,\n                    make calls, and engage customers directly from your CRM.\n                </p>\n                <ul class=\"feature-list ps-0\">\n                    <li><i class=\"fas fa-check-circle me-2\"></i> Template & Interactive Messages</li>\n                    <li><i class=\"fas fa-check-circle me-2\"></i> Voice Calls via WhatsApp</li>\n                    <li><i class=\"fas fa-check-circle me-2\"></i> Seamless CRM Integration</li>\n                    <li><i class=\"fas fa-check-circle me-2\"></i> Real-time Delivery Status</li>\n                </ul>\n            </div>\n            <div class=\"col-lg-6\">\n                <!-- Registration Form -->\n                <div class=\"walue-card card shadow-lg\">\n                    <div class=\"card-header\">\n                        <h5 class=\"mb-0\"><i class=\"fas fa-rocket me-2\"></i>Get Started</h5>\n                    </div>\n                    <div class=\"card-body\">\n                        <form id=\"registration-form\">\n                            <div class=\"mb-3\">\n                                <label for=\"customer_name\" class=\"form-label\">Company Name</label>\n                                <input type=\"text\" class=\"form-control\" id=\"customer_name\" placeholder=\"Your company name\" required>\n                            </div>\n                            <div class=\"mb-3\">\n                                <label for=\"company_email\" class=\"form-label\">Email</label>\n                                <input type=\"email\" class=\"form-control\" id=\"company_email\" placeholder=\"you@company.com\" required>\n                            </div>\n                            <div class=\"mb-3\">\n                                <label for=\"frappe_site_url\" class=\"form-label\">Frappe Site URL</label>\n                                <input type=\"url\" class=\"form-control\" id=\"frappe_site_url\" placeholder=\"https://your-site.erpnext.com\" required>\n                                <div class=\"form-text\">Your ERPNext or Frappe Cloud site</div>\n                            </div>\n                            <div class=\"mb-4\">\n                                <label for=\"subscription_plan\" class=\"form-label\">Plan</label>\n                                <select class=\"form-select\" id=\"subscription_plan\">\n                                    <option value=\"Starter\">Starter - $29/mo</option>\n                                    <option value=\"Professional\">Professional - $99/mo</option>\n                                    <option value=\"Enterprise\">Enterprise - $299/mo</option>\n                                </select>\n                            </div>\n                            <div class=\"d-grid\">\n                                <button type=\"submit\" class=\"btn btn-walue btn-lg\" id=\"register-btn\">\n                                    Continue <i class=\"fas fa-arrow-right ms-2\"></i>\n                                </button>\n                            </div>\n                        </form>\n                        <div id=\"registration-result\" class=\"mt-3\" style=\"display: none;\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- How It Works -->\n<section class=\"features-section\">\n    <div class=\"container\">\n        <h2>How It Works</h2>\n        <div class=\"row g-4\">\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body text-center p-4\">\n                        <div class=\"feature-icon\"><i class=\"fas fa-user-plus\"></i></div>\n                        <h5>1. Register</h5>\n                        <p class=\"text-muted mb-0\">Create your account with basic business details</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body text-center p-4\">\n                        <div class=\"feature-icon\"><i class=\"fab fa-whatsapp\"></i></div>\n                        <h5>2. Connect WhatsApp</h5>\n                        <p class=\"text-muted mb-0\">Link your WhatsApp Business Account via Meta</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-4\">\n                <div class=\"walue-card card h-100\">\n                    <div class=\"card-body text-center p-4\">\n                        <div class=\"feature-icon\"><i class=\"fas fa-plug\"></i></div>\n                        <h5>3. Install & Go</h5>\n                        <p class=\"text-muted mb-0\">One-click setup on your Frappe site</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Footer -->\n<footer class=\"walue-footer text-center\">\n    <div class=\"container\">\n        <p class=\"mb-0 opacity-75\">&copy; 2025 Walue Biz. WhatsApp Business Solution Provider.</p>\n    </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n<script>\nconst PROVIDER_URL = window.location.origin;\nconst STORAGE_KEYS = { CUSTOMER_ID: 'walue_customer_id', CUSTOMER_DATA: 'walue_customer_data', SESSION_ID: 'walue_session_id' };\n\nasync function apiCall(endpoint, method, data) {\n    const url = PROVIDER_URL + '/api/method/' + endpoint;\n    const options = { method: method, headers: { 'Content-Type': 'application/json' } };\n    if (data && method !== 'GET') options.body = JSON.stringify(data);\n    const response = await fetch(url, options);\n    const result = await response.json();\n    return result.message || result;\n}\n\nfunction saveCustomerData(data) {\n    localStorage.setItem(STORAGE_KEYS.CUSTOMER_DATA, JSON.stringify(data));\n    if (data.customer_id) localStorage.setItem(STORAGE_KEYS.CUSTOMER_ID, data.customer_id);\n}\n\nfunction getCustomerData() {\n    const data = localStorage.getItem(STORAGE_KEYS.CUSTOMER_DATA);\n    return data ? JSON.parse(data) : null;\n}\n\nfunction showToast(message, type) {\n    const toast = document.createElement('div');\n    toast.className = 'toast-notification toast-' + type;\n    toast.innerHTML = '<i class=\"fas fa-' + (type === 'success' ? 'check-circle' : 'exclamation-circle') + ' me-2\"></i>' + message;\n    document.body.appendChild(toast);\n    setTimeout(function() { toast.classList.add('show'); }, 10);\n    setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 300); }, 3000);\n}\n\ndocument.addEventListener('DOMContentLoaded', function() {\n    const customerData = getCustomerData();\n    if (customerData && customerData.customer_id) {\n        window.location.href = '/walue-dashboard';\n        return;\n    }\n    \n    const form = document.getElementById('registration-form');\n    if (form) form.addEventListener('submit', handleRegistration);\n});\n\nasync function handleRegistration(event) {\n    event.preventDefault();\n    const btn = document.getElementById('register-btn');\n    const resultDiv = document.getElementById('registration-result');\n    \n    const formData = {\n        customer_name: document.getElementById('customer_name').value.trim(),\n        company_email: document.getElementById('company_email').value.trim(),\n        frappe_site_url: document.getElementById('frappe_site_url').value.trim(),\n        subscription_plan: document.getElementById('subscription_plan').value\n    };\n    \n    if (!formData.customer_name || !formData.company_email || !formData.frappe_site_url) {\n        resultDiv.style.display = 'block';\n        resultDiv.className = 'alert alert-danger';\n        resultDiv.innerHTML = 'Please fill in all required fields.';\n        return;\n    }\n    \n    if (!formData.frappe_site_url.startsWith('http://') && !formData.frappe_site_url.startsWith('https://')) {\n        formData.frappe_site_url = 'https://' + formData.frappe_site_url;\n    }\n    \n    btn.disabled = true;\n    btn.innerHTML = '<i class=\"fas fa-spinner fa-spin me-2\"></i>Registering...';\n    resultDiv.style.display = 'none';\n    \n    try {\n        const result = await apiCall('walue_whatsapp_provider.api.customers.register', 'POST', formData);\n        if (result.success) {\n            const savedData = Object.assign({}, result, formData, { registered_at: new Date().toISOString() });\n            saveCustomerData(savedData);\n            resultDiv.style.display = 'block';\n            resultDiv.className = 'alert alert-success';\n            resultDiv.innerHTML = '<strong>Registration successful!</strong><br>Customer ID: ' + result.customer_id + '<br><small class=\"text-muted\">Redirecting to dashboard...</small>';\n            setTimeout(function() { window.location.href = '/walue-dashboard'; }, 2000);\n        } else {\n            resultDiv.style.display = 'block';\n            resultDiv.className = 'alert alert-danger';\n            resultDiv.innerHTML = result.error || 'Registration failed. Please try again.';\n            btn.disabled = false;\n            btn.innerHTML = 'Continue <i class=\"fas fa-arrow-right ms-2\"></i>';\n        }\n    } catch (error) {\n        console.error('Registration error:', error);\n        resultDiv.style.display = 'block';\n        resultDiv.className = 'alert alert-danger';\n        resultDiv.innerHTML = 'Could not connect to server. Please try again later.';\n        btn.disabled = false;\n        btn.innerHTML = 'Continue <i class=\"fas fa-arrow-right ms-2\"></i>';\n    }\n}\n</script>"
  }
]
